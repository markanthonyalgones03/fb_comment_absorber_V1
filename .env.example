# Meta / Facebook API Configuration
# Copy this file to .env and insert your Meta Developer credentials.
# Never commit the .env file with real credentials to source control.

# Meta App ID (from Meta for Developers App Dashboard)
META_APP_ID=

# Meta App Secret (from App Dashboard -> App settings -> Basic)
META_APP_SECRET=

# Meta Access Token (User Access Token or Page Access Token with required permissions:
# pages_show_list, pages_read_engagement, pages_read_user_content)
META_ACCESS_TOKEN=
